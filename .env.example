# ==========================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Replace with your Supabase Transaction Pooler connection string:
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or Direct Connection: postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ==========================================
# AUTHENTICATION & SESSIONS
# ==========================================
# A random secret used to sign session cookies (e.g., generate with: openssl rand -hex 32)
SESSION_SECRET=mood_aware_super_secure_random_production_secret_key_12345

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# OPTIONAL: AI INTEGRATION
# ==========================================
OPENAI_API_KEY=
