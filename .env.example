# ==========================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Supabase IPv4 Pooler Connection:
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ==========================================
# SUPABASE API CREDENTIALS
# ==========================================
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# AUTHENTICATION & SESSIONS
# ==========================================
# A random secret used to sign session cookies (e.g., generate with: openssl rand -hex 32)
SESSION_SECRET=mood_aware_super_secure_random_production_secret_key_12345

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# OPTIONAL: AI INTEGRATION
# ==========================================
OPENAI_API_KEY=
