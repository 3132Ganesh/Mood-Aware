# ==========================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# Direct Connection: postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres

# ==========================================
# SUPABASE API CREDENTIALS
# ==========================================
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# AUTHENTICATION & SESSIONS
# ==========================================
# A random secret used to sign session cookies (e.g., generate with: openssl rand -hex 32)
SESSION_SECRET=mood_aware_super_secure_random_production_secret_key_12345

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# OPTIONAL: AI INTEGRATION
# ==========================================
OPENAI_API_KEY=
